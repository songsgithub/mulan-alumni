# ---------- 数据库（PostgreSQL 16，docker compose up -d postgres） ----------
# 生产务必改密码；本机 5432 被占时改 POSTGRES_PORT（DATABASE_URI 里的端口一起改）
POSTGRES_USER=mulan
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=mulan_alumni
POSTGRES_PORT=5432
DATABASE_URI=postgresql://mulan:change-me-db-password@127.0.0.1:5432/mulan_alumni

# ---------- Payload ----------
# 生产环境必须替换为随机长字符串：openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-random-32-byte-string
# 用于生成邮件/链接的站点地址
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------- 对象存储（S3 兼容：阿里云 OSS / MinIO / Cloudflare R2） ----------
# 留空则使用本地磁盘（media/ 与 finance-evidence/，生产必须挂卷并纳入 scripts/backup.sh）
# S3_PUBLIC_URL：对象存储的公开访问域名（图片优化只放行本站与这个域名）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# ---------- 域名分流（三域，见 docs/设计规范.md §7.1） ----------
# 公众域：默认裸域（localhost / www.mulan.org），不配置
# 工作台域：业务工作台 + 登录 / 邀请注册（核心成员 / 团长 / 项目组）
WORKSPACE_HOST=connect.localhost
# CMS 域：Payload CMS 后台（仅运维账号，与业务账号分离）
CMS_HOST=admin.localhost

# ---------- 业务参数（见 docs/系统设计.md 第八节） ----------
# 预算上限、预计参与人数下限、两位审核负责人都在工作台「设置」里配置（存数据库，不用环境变量）。

# ---------- 反向代理 ----------
# 限流按真实 IP 计：Nginx 请设 proxy_set_header X-Real-IP $remote_addr;
# 没有 X-Real-IP 时取 X-Forwarded-For 的倒数第 N 个（N = 你前面有几层代理）
TRUSTED_PROXY_HOPS=1
# CMS 首个后台账号：默认由种子脚本建；确需在后台页面上建首个账号时临时设 1，建完删掉
# CMS_ALLOW_FIRST_USER=1


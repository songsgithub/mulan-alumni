{
  "name": "mulan-alumni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "数字木兰校友会 · 互助团运营系统（Next.js + Payload CMS + PostgreSQL）",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "bash scripts/dev-run.sh",
    "dev:clean": "rm -rf .next/dev .next/types && bash scripts/dev-run.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "db:push": "payload db:push",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@napi-rs/canvas": "^1.0.13",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "graphql": "^16.8.1",
    "lucide-react": "^0.545.0",
    "next": "16.4.3",
    "payload": "3.92.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "sharp@0.34.5": true
  }
}
